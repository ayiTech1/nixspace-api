# ─────────────────────────────────────────────────────────────
# NixSpace API — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=nixspace
DB_USER=nixspace
DB_PASSWORD=nixspace

# ── Redis ─────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Kafka ─────────────────────────────────────────────────────
KAFKA_HOSTS=localhost:9092

# ── JWT ───────────────────────────────────────────────────────
# Generate a secure secret: openssl rand -base64 48
JWT_SECRET=NixSpaceSuperSecretKeyThatMustBeAtLeast32CharactersLong!

# ── AWS ───────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=nixspace-files

# ── Server ────────────────────────────────────────────────────
SERVER_PORT=8080
WS_ORIGINS=http://localhost:3000,http://localhost:3001
